# TradeBridge AI Backend — environment variable template
# Copy to .env and fill in all values. Never commit .env to version control.
#
# VERCEL DEPLOYMENT: add every variable below to your Vercel project's
# Environment Variables (Settings → Environment Variables). The local .env
# file is only used for local development — Vercel ignores it.

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the FRONTEND app. Used to compute the Deriv OAuth redirect URI.
APP_URL=https://your-frontend.vercel.app

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# New secret key — Dashboard › Settings › API Keys › Publishable and secret
SUPABASE_SECRET_KEY=sb_secret_...
# New publishable key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated exact frontend origins allowed to call the backend
TRADEBRIDGE_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Shared secret ─────────────────────────────────────────────────────────────
# Must match TRADEBRIDGE_SESSION_BRIDGE_TOKEN in the frontend exactly
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
TRADEBRIDGE_SESSION_BRIDGE_TOKEN=

# ── Deriv ─────────────────────────────────────────────────────────────────────
# Numeric App ID from https://api.deriv.com — used by the WebSocket proxy
DERIV_APP_ID=
# OAuth Client ID for the authorization code + PKCE flow (same value as App ID)
DERIV_OAUTH_CLIENT_ID=
# Exact redirect URI registered in your Deriv app — must match APP_URL/api/auth/deriv/callback
DERIV_OAUTH_REDIRECT_URI=https://your-frontend.vercel.app/api/auth/deriv/callback

# ── Credential encryption ─────────────────────────────────────────────────────
# Set once, never change — rotating this invalidates all stored Deriv tokens
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADEBRIDGE_CREDENTIAL_ENCRYPTION_KEY=

# ── Trading gates ─────────────────────────────────────────────────────────────
TRADEBRIDGE_REAL_TRADING_ENABLED=false
TRADEBRIDGE_REAL_MAX_STAKE=10
TRADEBRIDGE_DEMO_MAX_STAKE=1000
TRADEBRIDGE_MT5_REAL_MAX_VOLUME=1.0

# ── Server-to-server API token ────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADEBRIDGE_API_TOKEN=
