# TradeBridge AI Backend — environment variable template
# Copy to .env and fill in all values before deploying.
# Never commit the real .env to version control.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Frontend origin (CORS) ──────────────────────────────────────────────────
# Comma-separated list of exact origins allowed to make browser requests.
TRADEBRIDGE_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Session bridge (Next.js server → FastAPI) ───────────────────────────────
# Must match TRADEBRIDGE_SESSION_BRIDGE_TOKEN in the frontend .env.
TRADEBRIDGE_SESSION_BRIDGE_TOKEN=

# ── Deriv OAuth ─────────────────────────────────────────────────────────────
DERIV_APP_ID=

# ── Credential encryption ───────────────────────────────────────────────────
# 32-byte URL-safe base64 key used to encrypt stored Deriv OAuth tokens.
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TRADEBRIDGE_CREDENTIAL_ENCRYPTION_KEY=

# ── Deriv real-account trading gate ─────────────────────────────────────────
# Set TRADEBRIDGE_REAL_TRADING_ENABLED=true to allow real-money Deriv
# Options and Multipliers orders. Fails closed (disabled) when unset.
TRADEBRIDGE_REAL_TRADING_ENABLED=false

# Absolute server-side ceiling on stake size for real Deriv orders (USD).
# Every buy is checked against min(this value, per-account consent max_stake).
# Must be set to a positive number before real trading can be enabled.
TRADEBRIDGE_REAL_MAX_STAKE=10

# Maximum stake for demo orders (default 1000 if unset).
TRADEBRIDGE_DEMO_MAX_STAKE=1000

# ── MT5 real-account volume cap ─────────────────────────────────────────────
# Maximum lot size the backend will accept for real-account MT5 orders.
# Leave unset to apply only the hard 100-lot absolute cap.
# Recommended starting value: 1.0 (1 standard lot).
TRADEBRIDGE_MT5_REAL_MAX_VOLUME=1.0

# ── Server-to-server API token (research endpoints) ─────────────────────────
TRADEBRIDGE_API_TOKEN=
